  brass_radio.xml — the brass radio button (brass 1.4.0): its own drawable, no buttonTint, so
  on and off read the same with the remote's focus; the focus frame is focus_ring.xml around
  the row.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:drawable="@drawable/brass_radio_on" />
    <item android:drawable="@drawable/brass_radio_off" />
</selector>
